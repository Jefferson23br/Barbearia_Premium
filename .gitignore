# ============================================================
# .gitignore - Sistema Prótese Capilar
# ============================================================

# ============================================================
# DEPENDÊNCIAS
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================================
# AMBIENTE / VARIÁVEIS DE AMBIENTE
# ============================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# ============================================================
# NEXT.JS / FRONTEND
# ============================================================
# Build outputs
.next/
out/
dist/
build/

# Next.js cache
.next/cache/
.vercel/

# ============================================================
# BACKEND
# ============================================================
# Uploads e arquivos gerados
backend/uploads/
backend/logs/
backend/*.log
*.log

# ============================================================
# SISTEMA OPERACIONAL
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================================
# IDEs E EDITORES
# ============================================================
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc)
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# ============================================================
# TESTES
# ============================================================
coverage/
.nyc_output/
*.lcov
.jest/
*.test.js.snap

# ============================================================
# TEMPORÁRIOS
# ============================================================
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.swp
*.swo
*~

# ============================================================
# CERTIFICADOS E CHAVES
# ============================================================
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
secrets/
*.secret

# ============================================================
# BANCO DE DADOS
# ============================================================
*.sqlite
*.sqlite3
*.db
*.db-journal
dump.sql
backup*.sql

# ============================================================
# PM2
# ============================================================
.pm2/
ecosystem.config.js.backup

# ============================================================
# DOCKER
# ============================================================
docker-compose.override.yml
.dockerignore

# ============================================================
# OUTROS
# ============================================================
# Arquivos de configuração local
config.local.json
settings.local.json

# Arquivos de debug
*.log
logs/
*.pid
*.seed
*.pid.lock

# Arquivos de cache
.cache/
.parcel-cache/
.turbo/

# Arquivos de build do TypeScript
*.tsbuildinfo

# Arquivos de análise
.analyze/
.bundle-analyzer/

# Arquivos de deploy
deploy.sh.backup
*.sh.backup

# Arquivos de documentação gerados
docs/_build/
docs/.doctrees/

# Arquivos de backup do sistema
*.backup
backup/
backups/

# ============================================================
# ESPECÍFICOS DO PROJETO
# ============================================================
# Scripts SQL temporários (manter apenas os finais)
*_TEMP.sql
*_OLD.sql
*_BACKUP.sql

# Arquivos de configuração do servidor (não versionar)
server-config.json
vps-config.json

# Arquivos de credenciais
credentials.json
secrets.json
*.credentials

# Arquivos de monitoramento local
monitor.log
health-check.log















